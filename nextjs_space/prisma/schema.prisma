generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  accounts      Account[]
  sessions      Session[]
  settings      UserSetting[]
  jiraCache JiraCache[]
  mentions      Mention[]
  savedItems    SavedItem[]
  priorityRules PriorityRule[]
  promises      Promise[]
  analyzed      AnalyzedMessage[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Mention {
  userId     String
  id         String
  ts         String
  datetime   DateTime
  channel    String
  channelId  String
  author     String
  text       String
  permalink  String
  priority   Boolean  @default(false)
  handled    Boolean  @default(false)
  handledAt  DateTime?
  handledSource String?
  queued     Boolean  @default(false)
  threadTs   String?
  deleted    Boolean  @default(false)
  deletedAt  DateTime?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, id])
  @@index([priority])
  @@index([handled])
  @@index([deleted])
  @@index([channelId])
  @@index([datetime])
}

model SavedItem {
  userId     String
  id         String
  ts         String
  channelId  String
  channel    String   @default("")
  author     String   @default("")
  text       String   @default("")
  permalink  String   @default("")
  kind       String   @default("saved")
  threadTs   String?
  savedAt    DateTime @default(now())
  reminderAt DateTime?
  handled    Boolean  @default(false)
  handledAt  DateTime?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, id])
  @@index([handled])
}

model PriorityRule {
  id        String   @id @default(cuid())
  userId    String
  type      String   // "channel" | "author" | "thread"
  value     String
  label     String   @default("")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([type])
  @@index([userId])
}

model Promise {
  userId     String
  id         String
  ts         String
  datetime   DateTime
  channel    String
  channelId  String
  toWhom     String
  action     String
  condition  String   @default("")
  deadline   String   @default("")
  status     String   @default("active")
  sourceText String   @default("")
  permalink  String
  priority   Boolean  @default(false)
  note       String   @default("")
  threadTs   String?
  completedSource String?
  deleted    Boolean  @default(false)
  deletedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, id])
  @@index([status])
  @@index([priority])
  @@index([deleted])
  @@index([channelId])
}

// Сообщения Левона, уже отправленные на анализ обязательств. Нужны, чтобы при каждом
// обновлении из Slack не гонять в LLM одни и те же сообщения. Таблица также создаётся
// лениво (CREATE TABLE IF NOT EXISTS) в lib/analyzed.ts, поэтому db push не обязателен.
model AnalyzedMessage {
  userId     String
  id         String
  analyzedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, id])
}

// Токены и настройки интеграций пользователя (Slack, Anthropic, Jira). Значения хранятся
// зашифрованными (AES-256-GCM, lib/crypto.ts). Таблица также создаётся лениво
// (CREATE TABLE IF NOT EXISTS) в lib/settings.ts, поэтому db push не обязателен.
model JiraCache {
  userId    String
  kind      String
  payload   Json
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, kind])
}

model UserSetting {
  userId    String
  key       String
  value     String
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
}
